# Copy this file to .env and fill in real values before running in
# production. Nothing here is required to run the app locally — every
# variable has a sensible default or degrades gracefully if unset.

# Optional. Enables AI summarization of watchlist attachment evidence
# (PDF, PNG, JPEG, and TXT files). Without this set, uploads still work
# exactly the same — the summary is just marked "skipped" instead of
# generated. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Set to "production" when deploying behind real HTTPS — this
# adds the Secure flag to session cookies automatically. Leave unset for
# local development (so the app still works over plain http://localhost).
NODE_ENV=

# Optional. Overrides the default port (4000).
PORT=

# Optional. How often (in milliseconds) the rule engine automatically
# re-evaluates active rules. Defaults to 5 minutes (300000).
RULE_ENGINE_INTERVAL_MS=
